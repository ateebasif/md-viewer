{
  "name": "mdv",
  "version": "1.0.0",
  "description": "A fast, offline Markdown viewer for macOS: themed reading, live reload, Finder integration",
  "keywords": [
    "markdown",
    "viewer",
    "reader",
    "macos",
    "live-reload",
    "cli",
    "finder",
    "offline"
  ],
  "homepage": "https://github.com/ateebasif/md-viewer#readme",
  "bugs": {
    "url": "https://github.com/ateebasif/md-viewer/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ateebasif/md-viewer.git"
  },
  "author": "ateebasif",
  "license": "MIT",
  "type": "module",
  "bin": {
    "mdv": "bin/mdv.js"
  },
  "scripts": {
    "start": "node bin/mdv.js"
  },
  "engines": {
    "node": ">=18"
  },
  "os": [
    "darwin"
  ],
  "private": true,
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/literata": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/opendyslexic": "^5.3.0",
    "highlight.js": "^11.12.0",
    "marked": "^18.1.2",
    "marked-alert": "^2.1.2",
    "marked-footnote": "^1.4.0",
    "marked-gfm-heading-id": "^4.1.4",
    "marked-highlight": "^2.2.4",
    "mermaid": "^12.2.0"
  }
